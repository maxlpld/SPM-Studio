# Keep installers runnable after GitHub downloads, Windows checkouts and browser uploads.
* text=auto
*.sh text eol=lf
*.command text eol=lf
*.py text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
# Batch files are stored with CRLF exactly as committed (cmd.exe needs CRLF; browser uploads skip conversion).
*.bat -text
# Binary assets
*.png binary
*.ico binary
*.icns binary
*.otf binary
*.ttf binary
*.zip binary
*.sxm binary
*.gwy binary
