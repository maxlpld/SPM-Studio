{
  "api_version": "1.0",
  "id": "cpd_histogram",
  "name": "CPD / Bias histogram",
  "version": "0.4.3",
  "description": "Named CPD masks and Gaussian fits; three-panel Z/raw Bias/masked-scan publication comparison with aligned histogram and selectable source channels.",
  "category": "KPFM",
  "entrypoint": "module:run",
  "mode": "analysis",
  "status": "experimental",
  "requires": [
    "numpy",
    "scipy",
    "matplotlib"
  ],
  "parameters": {
    "trace_mode": {
      "type": "choice",
      "label": "Trace",
      "default": "selected",
      "choices": [
        "selected",
        "forward",
        "backward",
        "both"
      ]
    },
    "bins": {
      "type": "integer",
      "label": "Histogram bins",
      "default": 130,
      "min": 20,
      "max": 1000
    },
    "populations": {
      "type": "integer",
      "label": "Default Gaussians per mask",
      "default": 2,
      "min": 0,
      "max": 8
    },
    "masks_json": {
      "type": "text",
      "label": "Named masks (JSON)",
      "default": "[]",
      "description": "Managed by the mask editor; JSON can also be imported/exported"
    },
    "topography_channel": {
      "type": "channel",
      "label": "Topography panel channel",
      "default": "Z",
      "description": "Choose the actual Z/topography channel from the scan."
    },
    "bias_panel_channel": {
      "type": "channel",
      "label": "Raw Bias panel channel",
      "default": "Bias",
      "description": "Choose which raw channel to display beside the topography and masks."
    },
    "show_topography": {
      "type": "bool",
      "label": "Export: show Z / topography",
      "default": true
    },
    "show_bias_panel": {
      "type": "bool",
      "label": "Export: show raw Bias",
      "default": true
    },
    "show_masked_panel": {
      "type": "bool",
      "label": "Export: show selected masks",
      "default": true
    },
    "rotate_export_180": {
      "type": "bool",
      "label": "Rotate exported images 180\u00b0 (legacy)",
      "default": true,
      "description": "Matches the original CPD publication orientation; does not modify numerical masks."
    },
    "topography_title": {
      "type": "string",
      "label": "Topography panel title",
      "default": "Z / Topography"
    },
    "bias_panel_title": {
      "type": "string",
      "label": "Raw Bias panel title",
      "default": "Bias raw"
    },
    "masked_panel_title": {
      "type": "string",
      "label": "Mask panel title",
      "default": "Selected mask regions"
    },
    "topography_cmap": {
      "type": "choice",
      "label": "Topography colormap",
      "default": "From plot profile",
      "choices": [
        "From plot profile",
        "Greys",
        "gray",
        "coolwarm",
        "RdBu_r",
        "viridis",
        "plasma",
        "inferno",
        "magma",
        "cividis",
        "turbo",
        "Blues",
        "bone",
        "seismic"
      ]
    },
    "bias_panel_cmap": {
      "type": "choice",
      "label": "Raw Bias colormap",
      "default": "From plot profile",
      "choices": [
        "From plot profile",
        "Greys",
        "gray",
        "coolwarm",
        "RdBu_r",
        "viridis",
        "plasma",
        "inferno",
        "magma",
        "cividis",
        "turbo",
        "Blues",
        "bone",
        "seismic"
      ]
    },
    "masked_panel_cmap": {
      "type": "choice",
      "label": "Masked scan colormap",
      "default": "From plot profile",
      "choices": [
        "From plot profile",
        "Greys",
        "gray",
        "coolwarm",
        "RdBu_r",
        "viridis",
        "plasma",
        "inferno",
        "magma",
        "cividis",
        "turbo",
        "Blues",
        "bone",
        "seismic"
      ]
    },
    "topography_colorbar": {
      "type": "bool",
      "label": "Z value scale",
      "default": true
    },
    "bias_colorbar": {
      "type": "bool",
      "label": "Bias value scale",
      "default": true
    },
    "masked_colorbar": {
      "type": "bool",
      "label": "Masked value scale",
      "default": false
    },
    "histogram_raw_curve": {
      "type": "bool",
      "label": "Show raw distribution in comparison",
      "default": true
    },
    "comparison_with_masked_image": {
      "type": "bool",
      "label": "Export masked-image comparison",
      "default": true
    },
    "image_scale_bar": {
      "type": "bool",
      "label": "Show physical image scale bar",
      "default": true
    },
    "raw_populations": {
      "type": "integer",
      "label": "Raw-only Gaussians (when no masks)",
      "default": 0,
      "min": 0,
      "max": 8
    },
    "add_mask_fits_to_raw": {
      "type": "bool",
      "label": "Reuse mask Gaussians in raw fit",
      "default": true,
      "description": "Fit only non-negative raw amplitudes; mask means and sigmas remain fixed"
    },
    "plot_title": {
      "type": "string",
      "label": "Plot title (optional)",
      "default": ""
    },
    "x_axis_label": {
      "type": "string",
      "label": "X label (optional)",
      "default": ""
    },
    "y_axis_label": {
      "type": "string",
      "label": "Y label (optional)",
      "default": ""
    },
    "scale_bar_color": {
      "type": "choice",
      "label": "Scale-bar color",
      "choices": [
        "white",
        "black"
      ],
      "default": "white"
    }
  },
  "interaction": "histogram_masks",
  "snapshot_channels": "selected",
  "selection": {
    "tools": [
      "rectangle"
    ],
    "multiple": false,
    "preview": "histogram"
  },
  "snapshot_parameter_channels": [
    "topography_channel",
    "bias_panel_channel"
  ]
}
